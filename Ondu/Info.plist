<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only audio. `fetch` and `processing` were declared but nothing uses
	     BGTaskScheduler, and an unused background mode is something review asks about. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- For Debug only in practice: release builds refuse an http:// server outright
	     (see LoginView.allowsInsecureServers), so nothing cleartext is ever requested.
	     This keeps a local server reachable without setting up TLS first, and is scoped
	     to local addresses rather than NSAllowsArbitraryLoads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS prompts before an app may reach LAN addresses. Without a string the prompt
	     gives the user nothing to decide on. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ondu connects to your music server, which is usually on your local network.</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
