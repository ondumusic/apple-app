// Shared build settings. Committed.
//
// The block below is the set of things a developer may want to change. Override any of
// them in Local.xcconfig, which is gitignored and included further down — anything set
// there wins, because a later assignment replaces an earlier one.

// ---------------------------------------------------------------------------
// Defaults
// ---------------------------------------------------------------------------

ONDU_BUNDLE_ID = com.ondumusic.Player
ONDU_APP_NAME = Ondu
ONDU_APPICON = AppIcon

// Debug installs alongside release by default, so a build that's mid-migration can't
// touch the library you actually listen to. Separate identifier means a separate
// container: its own database, downloads and keychain login.
ONDU_DEBUG_BUNDLE_ID = com.ondumusic.Player.dev
ONDU_DEBUG_APP_NAME = Ondu Dev
// Point at a second icon set once one exists, so the two are distinguishable on a home
// screen rather than only by name.
ONDU_DEBUG_APPICON = AppIcon

// Empty means "Sign to Run Locally", so a fresh clone builds and runs with no setup.
LOCAL_DEVELOPMENT_TEAM =

// Ad-hoc, which is what builds without a signing team. A machine with one can set
// "Apple Development" to get a signed macOS build instead.
LOCAL_MACOS_CODE_SIGN_IDENTITY = -

#include? "Local.xcconfig"

// ---------------------------------------------------------------------------
// Derived — nothing below here should need editing
// ---------------------------------------------------------------------------

EFFECTIVE_BUNDLE_ID = $(ONDU_BUNDLE_ID)
EFFECTIVE_BUNDLE_ID[config=Debug] = $(ONDU_DEBUG_BUNDLE_ID)

EFFECTIVE_APP_NAME = $(ONDU_APP_NAME)
EFFECTIVE_APP_NAME[config=Debug] = $(ONDU_DEBUG_APP_NAME)

EFFECTIVE_APPICON = $(ONDU_APPICON)
EFFECTIVE_APPICON[config=Debug] = $(ONDU_DEBUG_APPICON)

// The app's user-facing name, not its target name: macOS names an app after its file
// (Dock, Finder, Spotlight) and CFBundleName (menu bar, About), not CFBundleDisplayName,
// so this is what makes a Debug build "Ondu Dev" there — and stops it replacing a
// release copy of the same file name. The test target sets its own. The module keeps the
// target name, which is what `@testable import Ondu` needs. Lives here rather than on
// the target: it was deleted from the target by accident while clearing the other
// overrides.
PRODUCT_NAME = $(EFFECTIVE_APP_NAME)
PRODUCT_MODULE_NAME = $(TARGET_NAME)

PRODUCT_BUNDLE_IDENTIFIER = $(EFFECTIVE_BUNDLE_ID)
INFOPLIST_KEY_CFBundleDisplayName = $(EFFECTIVE_APP_NAME)
ASSETCATALOG_COMPILER_APPICON_NAME = $(EFFECTIVE_APPICON)

// Only HTTPS to the user's own server, so no encryption beyond what the OS provides and
// the app is exempt. Without this, every App Store upload asks the question again.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// Shown on the store listing and used by the OS to group the app.
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.music
DEVELOPMENT_TEAM = $(LOCAL_DEVELOPMENT_TEAM)
CODE_SIGN_IDENTITY[sdk=macosx*] = $(LOCAL_MACOS_CODE_SIGN_IDENTITY)

// iPhone and the Mac we develop against. visionOS was still listed on the app target
// after the move to an iPhone-only device family, advertising a platform nobody has
// built or tested. Catalyst is off because the Mac build is native, not a port.
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
